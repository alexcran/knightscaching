---
interface Props {
  handle: string;
  href: string;
}

const { handle, href } = Astro.props;
---

<a href={href} class="cacher-card">
  <span class="card-marker" aria-hidden="true">◆</span>
  <span class="card-handle">{handle}</span>
  <span class="card-cta">
    View profile
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M2 6h8M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</a>
